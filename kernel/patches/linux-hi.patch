diff -ruN a/drivers/video/fbdev/sunxi/disp2/disp/lcd/gc9307_9bit_spi.c b/drivers/video/fbdev/sunxi/disp2/disp/lcd/gc9307_9bit_spi.c
--- a/drivers/video/fbdev/sunxi/disp2/disp/lcd/gc9307_9bit_spi.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/video/fbdev/sunxi/disp2/disp/lcd/gc9307_9bit_spi.c	2026-11-12 23:03:21.001987620 +0000
@@ -0,0 +1,252 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Painel GC9307 240x320 por SPI de 9 bits (3 fios, bit-bang por GPIO) da Creality Hi.
+ *
+ * Projeto Hi (12/11/2026): reconstruído a partir do kernel da Creality 1.1.0.74
+ * (função por função, desmontagem de gc9307_9bit_spi_tjc_240_320), para o kernel
+ * Tina 5.4.61 compilado por nós. Mesmo nome de painel do device tree da Hi:
+ *   lcd_driver_name = "gc9307_9bit_spi_tjc_240_320"
+ * GPIOs (lcd_gpio_N do device tree): 0 = reset, 1 = clock, 2 = dados, 3 = CS.
+ */
+#include "gc9307_9bit_spi.h"
+
+static void LCD_power_on(u32 sel);
+static void LCD_power_off(u32 sel);
+static void LCD_bl_open(u32 sel);
+static void LCD_bl_close(u32 sel);
+static void LCD_panel_init(u32 sel);
+static void LCD_panel_exit(u32 sel);
+
+/* palavra de 9 bits: bit 8 = 0 comando, 1 dado; MSB primeiro, ~2 us por meio ciclo */
+static void gc9307_9bit_write(u32 value)
+{
+	int i;
+
+	sunxi_lcd_gpio_set_value(0, 3, 0);
+	for (i = 8; i >= 0; i--) {
+		sunxi_lcd_gpio_set_value(0, 2, (value & (1u << i)) ? 1 : 0);
+		sunxi_lcd_delay_us(2);
+		sunxi_lcd_gpio_set_value(0, 1, 1);
+		sunxi_lcd_delay_us(2);
+		sunxi_lcd_gpio_set_value(0, 1, 0);
+	}
+	sunxi_lcd_gpio_set_value(0, 3, 1);
+}
+
+static void LCD_cfg_panel_info(struct panel_extend_para *info)
+{
+	u32 i = 0, j = 0;
+	u32 items;
+	u8 lcd_gamma_tbl[][2] = {
+		{0, 0},     {15, 15},   {30, 30},   {45, 45},   {60, 60},
+		{75, 75},   {90, 90},   {105, 105}, {120, 120}, {135, 135},
+		{150, 150}, {165, 165}, {180, 180}, {195, 195}, {210, 210},
+		{225, 225}, {240, 240}, {255, 255},
+	};
+	u32 lcd_cmap_tbl[2][3][4] = {
+		{
+			{LCD_CMAP_G0, LCD_CMAP_B1, LCD_CMAP_G2, LCD_CMAP_B3},
+			{LCD_CMAP_B0, LCD_CMAP_R1, LCD_CMAP_B2, LCD_CMAP_R3},
+			{LCD_CMAP_R0, LCD_CMAP_G1, LCD_CMAP_R2, LCD_CMAP_G3},
+		},
+		{
+			{LCD_CMAP_B3, LCD_CMAP_G2, LCD_CMAP_B1, LCD_CMAP_G0},
+			{LCD_CMAP_R3, LCD_CMAP_B2, LCD_CMAP_R1, LCD_CMAP_B0},
+			{LCD_CMAP_G3, LCD_CMAP_R2, LCD_CMAP_G1, LCD_CMAP_R0},
+		},
+	};
+
+	items = sizeof(lcd_gamma_tbl) / 2;
+	for (i = 0; i < items - 1; i++) {
+		u32 num = lcd_gamma_tbl[i + 1][0] - lcd_gamma_tbl[i][0];
+
+		for (j = 0; j < num; j++) {
+			u32 value = lcd_gamma_tbl[i][1] +
+				((lcd_gamma_tbl[i + 1][1] - lcd_gamma_tbl[i][1]) * j) / num;
+			info->lcd_gamma_tbl[lcd_gamma_tbl[i][0] + j] =
+				(value << 16) + (value << 8) + value;
+		}
+	}
+	info->lcd_gamma_tbl[255] = (lcd_gamma_tbl[items - 1][1] << 16) +
+				   (lcd_gamma_tbl[items - 1][1] << 8) +
+				   lcd_gamma_tbl[items - 1][1];
+	memcpy(info->lcd_cmap_tbl, lcd_cmap_tbl, sizeof(lcd_cmap_tbl));
+}
+
+static s32 LCD_open_flow(u32 sel)
+{
+	LCD_OPEN_FUNC(sel, LCD_power_on, 0);
+	LCD_OPEN_FUNC(sel, LCD_panel_init, 200);
+	LCD_OPEN_FUNC(sel, sunxi_lcd_tcon_enable, 150);
+	LCD_OPEN_FUNC(sel, LCD_bl_open, 0);
+	return 0;
+}
+
+static s32 LCD_close_flow(u32 sel)
+{
+	LCD_CLOSE_FUNC(sel, LCD_bl_close, 0);
+	gc9307_9bit_write(0x028);	/* display off */
+	msleep(50);
+	gc9307_9bit_write(0x010);	/* sleep in */
+	msleep(120);
+	LCD_CLOSE_FUNC(sel, sunxi_lcd_tcon_disable, 0);
+	LCD_CLOSE_FUNC(sel, LCD_panel_exit, 100);
+	LCD_CLOSE_FUNC(sel, LCD_power_off, 0);
+	return 0;
+}
+
+static void LCD_power_on(u32 sel)
+{
+	/* reset: alto, 50 ms, baixo, 50 ms, alto, 180 ms */
+	sunxi_lcd_gpio_set_value(0, 0, 1);
+	usleep_range(50000, 50000);
+	sunxi_lcd_gpio_set_value(0, 0, 0);
+	usleep_range(50000, 50000);
+	sunxi_lcd_gpio_set_value(0, 0, 1);
+	usleep_range(180000, 180000);
+	sunxi_lcd_pin_cfg(sel, 1);
+}
+
+static void LCD_power_off(u32 sel)
+{
+	sunxi_lcd_pin_cfg(sel, 0);
+	sunxi_lcd_gpio_set_value(0, 0, 0);
+	sunxi_lcd_gpio_set_value(0, 1, 0);
+	sunxi_lcd_gpio_set_value(0, 3, 0);
+	sunxi_lcd_gpio_set_value(0, 2, 0);
+}
+
+static void LCD_bl_open(u32 sel)
+{
+	sunxi_lcd_pwm_enable(sel);
+	sunxi_lcd_backlight_enable(sel);
+}
+
+static void LCD_bl_close(u32 sel)
+{
+	sunxi_lcd_backlight_disable(sel);
+	sunxi_lcd_pwm_disable(sel);
+}
+
+static void LCD_panel_init(u32 sel)
+{
+	sunxi_lcd_gpio_set_direction(0, 0, 1);
+	sunxi_lcd_gpio_set_direction(0, 2, 1);
+	sunxi_lcd_gpio_set_direction(0, 1, 1);
+	sunxi_lcd_gpio_set_direction(0, 3, 1);
+	usleep_range(5000, 5000);
+	sunxi_lcd_gpio_set_value(0, 0, 1);
+	sunxi_lcd_gpio_set_value(0, 2, 0);
+	sunxi_lcd_gpio_set_value(0, 1, 0);
+	sunxi_lcd_gpio_set_value(0, 3, 1);
+	printk("start gc9307 init.\n");
+	usleep_range(50000, 50000);
+	gc9307_9bit_write(0x0fe);	/* cmd */
+	gc9307_9bit_write(0x0ef);	/* cmd */
+	gc9307_9bit_write(0x036);	/* cmd */
+	gc9307_9bit_write(0x140);
+	gc9307_9bit_write(0x03a);	/* cmd */
+	gc9307_9bit_write(0x160);
+	gc9307_9bit_write(0x084);	/* cmd */
+	gc9307_9bit_write(0x141);
+	gc9307_9bit_write(0x08a);	/* cmd */
+	gc9307_9bit_write(0x140);
