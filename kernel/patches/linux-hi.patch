diff -ruN a/drivers/i2c/busses/i2c-sunxi.c b/drivers/i2c/busses/i2c-sunxi.c
--- a/drivers/i2c/busses/i2c-sunxi.c	2025-07-10 01:07:19.000000000 +0000
+++ b/drivers/i2c/busses/i2c-sunxi.c	2026-11-13 11:15:02.080756892 +0000
@@ -57,7 +57,7 @@
 #include <linux/rpbuf.h>
 #endif /* CONFIG_AW_TWI_DELAYINIT */
 
-#define SUNXI_TWI_VERSION	"2.6.5"
+#define SUNXI_TWI_VERSION	"2.6.5-hi1"
 
 /* TWI Register Offset */
 /* 31:8bit reserved,7-1bit for slave addr,0 bit for GCE */
@@ -2315,10 +2315,28 @@
 		goto out;
 	}
 
-	if (twi->twi_drv_used)
-		ret = sunxi_twi_drv_xfer(twi, msgs, num);
-	else
-		ret = sunxi_twi_engine_xfer(twi, msgs, num);
+	{
+		/* Ajuste Projeto Hi: até 3 novas tentativas, 5 ms entre elas (EEPROM ocupada / barramento recém-acordado) */
+		int tentativa;
+		for (tentativa = 0; tentativa <= 3; tentativa++) {
+			if (tentativa) {
+				sunxi_err(twi->dev, "hi: nova tentativa %d (dev addr:0x%x, erro %d)\n",
+					  tentativa, msgs[0].addr, ret);
+				msleep(5);
+				sunxi_twi_soft_reset(twi);
+				if (sunxi_twi_bus_barrier(&twi->adap))
+					continue;
+			}
+			if (twi->twi_drv_used)
+				ret = sunxi_twi_drv_xfer(twi, msgs, num);
+			else
+				ret = sunxi_twi_engine_xfer(twi, msgs, num);
+			if (ret >= 0)
+				break;
+		}
+		if (tentativa && ret >= 0)
+			sunxi_err(twi->dev, "hi: recuperado na tentativa %d (dev addr:0x%x)\n", tentativa, msgs[0].addr);
+	}
 
 out:
 	pm_runtime_mark_last_busy(twi->dev);
