#!/bin/sh /etc/rc.common
# Projeto Hi: swap comprimido na RAM (zram), sem gastar o eMMC.
START=21
STOP=90

start() {
    [ -e /sys/block/zram0 ] || { insmod /lib/modules/5.4.61/zsmalloc.ko 2>/dev/null; insmod /lib/modules/5.4.61/zram.ko num_devices=1 2>/dev/null; }
    [ -e /sys/block/zram0 ] || exit 0
    grep -q zram0 /proc/swaps && exit 0
    echo lzo > /sys/block/zram0/comp_algorithm 2>/dev/null
    echo 256M > /sys/block/zram0/disksize
    mkswap /dev/zram0 >/dev/null && swapon -p 100 /dev/zram0
    echo 60 > /proc/sys/vm/swappiness
}

stop() {
    swapoff /dev/zram0 2>/dev/null
    echo 1 > /sys/block/zram0/reset 2>/dev/null
}
