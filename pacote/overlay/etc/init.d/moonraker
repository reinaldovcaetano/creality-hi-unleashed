#!/bin/sh /etc/rc.common
# Projeto Hi: Moonraker novo (/usr/share/moonraker-hi). Para voltar ao da Creality:
#   touch /mnt/UDISK/hi-moonraker-antigo && /etc/init.d/moonraker restart
START=56
USE_PROCD=1
DEPEND=fstab,mcu_update

PROG=/usr/share/moonraker-env/bin/python
LOG=/mnt/UDISK/printer_data/logs/moonraker.log
NOVO=/usr/share/moonraker-hi

start_service() {
	[ "x$(get_sn_mac.sh pcba_test)" = "x1" ] && exit 0
	procd_open_instance
	if [ -f /mnt/UDISK/hi-moonraker-antigo ]; then
		procd_set_param env HOME=/mnt/UDISK
		procd_set_param command ${PROG} /usr/share/moonraker/moonraker.py -c /usr/share/moonraker/moonraker.conf -l ${LOG}
	else
		procd_set_param env HOME=/mnt/UDISK PYTHONPATH=${NOVO}/vendor:${NOVO}
		procd_set_param command ${PROG} -m moonraker -d /mnt/UDISK/printer_data -c ${NOVO}/moonraker-hi.conf -l ${LOG}
	fi
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
