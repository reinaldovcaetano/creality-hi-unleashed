#!/bin/sh /etc/rc.common
# Projeto Hi: Hi Painel (tela própria). Sobe depois da tela da Creality e assume a tela quando ela chega na
# tela inicial. Queda de energia pendente: abre a tela própria de retomada. Impressão em andamento ou
# atualização no pendrive: fica a Creality. Na Creality: Ajuda > Wiki volta para o Hi Painel.
# Programa: /usr/bin/hi-painel (do pacote); se existir /mnt/UDISK/hi-painel/hi-painel (versão de teste), usa ela.
# Desligar: touch /mnt/UDISK/hi-painel/desligado
START=99
STOP=05
USE_PROCD=1

start_service() {
    [ -e /mnt/UDISK/hi-painel/desligado ] && return 0
    BIN=/usr/bin/hi-painel
    [ -x /mnt/UDISK/hi-painel/hi-painel ] && BIN=/mnt/UDISK/hi-painel/hi-painel
    [ -x "$BIN" ] || return 0
    procd_open_instance
    procd_set_param command /bin/sh -c "sleep 15; exec $BIN --boot >> /tmp/hi-painel.log 2>&1"
    procd_set_param respawn 3600 10 5
    procd_close_instance
}
stop_service() {
    killall hi-painel 2>/dev/null
    kill -CONT $(pidof display-server) 2>/dev/null
}
